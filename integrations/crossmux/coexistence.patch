+class HalFile;
+
+// Dedicated X4 Pro coexistence policy. Verification never changes flash or NVS.
+class HalMuseCoexist {
+ public:
+  static bool verifyPartition(const esp_partition_t* partition, std::string& error);
+  static bool verifyFile(const char* path, std::string& error);
+  static bool verifyOpenFile(HalFile& file, std::string& error);
+  static bool switchToMuse(std::string& error);
+};
