+++ b/scripts/tests/test_muse_coexist.py
@@ -0,0 +1,281 @@
+"""Host security regression for the production coexist verifier (no reader access)."""
+from pathlib import Path
+import hashlib
+import os
+import shutil
+import struct
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+CERT = b"MUSE_POCKET_COEXIST_CERT_V1".ljust(384, b"\0")
+TOKEN = b"MUSE_POCKET_TOKEN_SLOT_V1".ljust(128, b"\0")
+TOKEN_OFFSET, CERT_OFFSET = 288, 416
+
+
+def image(body):
+    header = bytearray(24)
+    header[0:2] = bytes([0xE9, 1])
+    header[12], header[23] = 9, 1
+    out = header + struct.pack("<II", 0x3C000020, len(body)) + body
+    checksum = 0xEF
+    for value in body:
+        checksum ^= value
+    offset = len(out) + 15 - len(out) % 16
+    out += bytes(offset - len(out)) + bytes([checksum])
