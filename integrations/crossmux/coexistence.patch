--- /dev/null
+++ b/src/platform/coexist_nvs_guard.cpp
@@ -0,0 +1,24 @@
+// The dedicated profile must preserve Muse pairing even when NVS is unreadable.
+#if defined(CROSSMUX_MUSE_COEXIST) && CROSSMUX_MUSE_COEXIST
+#include <esp_partition.h>
+
+extern "C" {
+esp_err_t __real_esp_partition_erase_range(const esp_partition_t*, size_t, size_t);
+
+esp_err_t __wrap_nvs_flash_erase() { return ESP_ERR_NOT_ALLOWED; }
+esp_err_t __wrap_nvs_flash_erase_partition(const char* partitionLabel) {
+  (void)partitionLabel;
+  return ESP_ERR_NOT_ALLOWED;
+}
+
+esp_err_t __wrap_esp_partition_erase_range(const esp_partition_t* partition, size_t offset, size_t length) {
+  // Protect initArduino's direct whole-partition recovery erase. Sector-level
+  // NVS garbage collection remains available for normal bounded persistence.
+  if (partition && partition->type == ESP_PARTITION_TYPE_DATA &&
+      partition->subtype == ESP_PARTITION_SUBTYPE_DATA_NVS && offset == 0 && length >= partition->size) {
+    return ESP_ERR_NOT_ALLOWED;
+  }
+  return __real_esp_partition_erase_range(partition, offset, length);
+}
+}
+#endif
