diff --git a/lib/hal/HalMuseCoexist.cpp b/lib/hal/HalMuseCoexist.cpp
new file mode 100644
index 0000000..02a5bf1
--- /dev/null
+++ b/lib/hal/HalMuseCoexist.cpp
@@ -0,0 +1,331 @@
+#include "HalMuseCoexist.h"
+
+#if CROSSMUX_MUSE_COEXIST
+#include <HalStorage.h>
+#include <Logging.h>
+#include <MuseCoexistPublicKey.h>
+#include <esp_flash.h>
+#include <esp_image_format.h>
+#include <esp_ota_ops.h>
+#include <esp_system.h>
+#include <mbedtls/pk.h>
+#include <mbedtls/sha256.h>
+
+#include <algorithm>
+#include <cstring>
+
+namespace {
+constexpr size_t CERT_SIZE = 384, PAYLOAD_SIZE = 184, TOKEN_SIZE = 128, CHUNK = 2048;
+constexpr char CERT_MARKER[] = "MUSE_POCKET_COEXIST_CERT_V1";
+constexpr char TOKEN_MARKER[] = "MUSE_POCKET_TOKEN_SLOT_V1";
+struct Geometry {
+  uint32_t size, checksum, digest;
+  uint32_t start[16], end[16];
+  uint8_t segments;
+};
+struct Source {
+  const esp_partition_t* partition;
+  HalFile* file;
+  size_t size;
+};
+uint32_t u32(const uint8_t* p) {
+  return uint32_t(p[0]) | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+}
+bool reject(std::string& error, const char* reason) {
+  error = reason;
+  return false;
+}
+bool read(const Source& source, size_t offset, void* data, size_t length) {
+  if (offset > source.size || length > source.size - offset) return false;
+  if (source.partition) return esp_partition_read(source.partition, offset, data, length) == ESP_OK;
+  return source.file && source.file->seekSet(offset) && source.file->read(data, length) == static_cast<int>(length);
+}
+bool fixed(const uint8_t* data, size_t size, const char* expected) {
+  const size_t n = std::strlen(expected);
+  if (n >= size || std::memcmp(data, expected, n)) return false;
+  for (size_t i = n; i < size; ++i)
+    if (data[i]) return false;
+  return true;
+}
+bool padded(const uint8_t* data, size_t size) {
+  size_t end = 0;
+  while (end < size && data[end]) ++end;
+  if (!end || end == size) return false;
+  for (size_t i = end; i < size; ++i)
+    if (data[i]) return false;
+  return true;
+}
+bool geometry(const Source& part, Geometry& g) {
+  uint8_t h[24];
+  if (!read(part, 0, h, sizeof(h)) || h[0] != 0xe9 || h[1] < 1 || h[1] > 16 || h[23] != 1 || h[12] != 9 || h[13] != 0)
+    return false;
+  g.segments = h[1];
+  uint32_t pos = 24;
+  for (unsigned i = 0; i < g.segments; ++i) {
+    uint8_t segment[8];
+    if (!read(part, pos, segment, 8)) return false;
+    pos += 8;
+    uint32_t n = u32(segment + 4);
+    if (pos > part.size || n > part.size - pos) return false;
+    g.start[i] = pos;
+    g.end[i] = pos + n;
+    pos += n;
+  }
+  if (pos > UINT32_MAX - 48) return false;
+  g.checksum = pos + (15 - pos % 16);
+  g.digest = g.checksum + 1;
+  g.size = g.digest + 32;
+  return g.size <= part.size;
+}
+bool contained(const Geometry& g, uint32_t offset, size_t size) {
+  for (unsigned i = 0; i < g.segments; ++i)
+    if (offset >= g.start[i] && offset <= g.end[i] && size <= g.end[i] - offset) return true;
+  return false;
+}
+bool intact(const Source& part, const Geometry& g) {
+  uint8_t buffer[CHUNK], actual[32], stored[32];
+  uint8_t checksum = 0xef;
+  mbedtls_sha256_context sha;
+  mbedtls_sha256_init(&sha);
+  bool ok = mbedtls_sha256_starts(&sha, 0) == 0;
+  for (uint32_t pos = 0; ok && pos < g.digest;) {
+    size_t n = std::min<size_t>(CHUNK, g.digest - pos);
+    ok = read(part, pos, buffer, n) && mbedtls_sha256_update(&sha, buffer, n) == 0;
+    for (size_t j = 0; ok && j < n; ++j)
+      for (unsigned i = 0; i < g.segments; ++i)
+        if (pos + j >= g.start[i] && pos + j < g.end[i]) {
+          checksum ^= buffer[j];
+          break;
+        }
+    pos += n;
+  }
+  uint8_t recorded = 0;
+  ok = ok && mbedtls_sha256_finish(&sha, actual) == 0 && read(part, g.digest, stored, 32) &&
+       read(part, g.checksum, &recorded, 1) && checksum == recorded && !std::memcmp(actual, stored, 32);
+  mbedtls_sha256_free(&sha);
+  return ok;
+}
+bool hash(const Source& part, const Geometry& g, uint8_t output[32], uint32_t token = UINT32_MAX,
+          uint32_t cert = UINT32_MAX) {
+  uint8_t buffer[CHUNK];
+  mbedtls_sha256_context sha;
+  mbedtls_sha256_init(&sha);
+  bool ok = mbedtls_sha256_starts(&sha, 0) == 0;
+  for (uint32_t pos = 0; ok && pos < g.size;) {
+    size_t n = std::min<size_t>(CHUNK, g.size - pos);
+    ok = read(part, pos, buffer, n);
+    if (token != UINT32_MAX)
+      for (size_t j = 0; j < n; ++j) {
+        const uint32_t offset = pos + j;
+        if (offset >= token && offset - token < TOKEN_SIZE) {
+          size_t k = offset - token;
+          buffer[j] = k < sizeof(TOKEN_MARKER) - 1 ? TOKEN_MARKER[k] : 0;
+        } else if (offset >= cert && offset - cert < CERT_SIZE) {
+          size_t k = offset - cert;
+          buffer[j] = k < sizeof(CERT_MARKER) - 1 ? CERT_MARKER[k] : 0;
+        } else if (offset == g.checksum || offset >= g.digest)
+          buffer[j] = 0;
+      }
+    ok = ok && mbedtls_sha256_update(&sha, buffer, n) == 0;
+    pos += n;
+  }
+  ok = ok && mbedtls_sha256_finish(&sha, output) == 0;
+  mbedtls_sha256_free(&sha);
+  return ok;
+}
+bool findCertificate(const Source& part, const Geometry& g, uint32_t& offset) {
+  uint8_t marker[32] = {};
+  std::memcpy(marker, CERT_MARKER, sizeof(CERT_MARKER) - 1);
+  uint8_t buffer[CHUNK + 31];
+  size_t carry = 0;
+  unsigned matches = 0;
+  for (uint32_t pos = 0; pos < g.size;) {
+    size_t n = std::min<size_t>(CHUNK, g.size - pos);
+    if (!read(part, pos, buffer + carry, n)) return false;
+    for (size_t j = 0; j + 32 <= carry + n; ++j)
+      if (!std::memcmp(buffer + j, marker, 32)) {
+        offset = pos - carry + j;
+        ++matches;
+      }
+    size_t total = carry + n;
+    carry = std::min<size_t>(31, total);
+    std::memmove(buffer, buffer + total - carry, carry);
+    pos += n;
+  }
+  return matches == 1 && contained(g, offset, CERT_SIZE);
+}
+bool canonicalToken(const uint8_t token[TOKEN_SIZE]) {
+  if (std::memcmp(token, "mgst_", 5)) return false;
+  for (size_t i = 5; i < 48; ++i) {
+    char c = token[i];
+    if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-'))
+      return false;
+  }
+  if (!token[47] || !std::strchr("AEIMQUYcgkosw048", token[47])) return false;
+  for (size_t i = 48; i < TOKEN_SIZE; ++i)
+    if (token[i]) return false;
+  return true;
+}
+bool signature(const uint8_t cert[CERT_SIZE]) {
+  const size_t length = cert[216] | size_t(cert[217]) << 8;
+  if (!length || length > 80) return false;
+  for (size_t i = 218 + length; i < CERT_SIZE; ++i)
+    if (cert[i]) return false;
+  // P-256 signatures use a short-form DER sequence with exactly two positive,
+  // minimally encoded integers. Reject trailing bytes and ambiguous encodings.
+  const uint8_t* der = cert + 218;
+  if (length < 8 || length > 72 || der[0] != 0x30 || der[1] != length - 2) return false;
+  size_t pos = 2;
+  for (int integer = 0; integer < 2; ++integer) {
+    if (pos + 2 > length || der[pos++] != 2) return false;
+    size_t n = der[pos++];
+    if (!n || n > 33 || n > length - pos || (der[pos] & 0x80) || (n > 1 && der[pos] == 0 && !(der[pos + 1] & 0x80)) ||
+        (n == 33 && der[pos] != 0))
+      return false;
+    pos += n;
+  }
+  if (pos != length) return false;
+  uint8_t digest[32];
+  mbedtls_sha256_context sha;
+  mbedtls_sha256_init(&sha);
+  bool ok = mbedtls_sha256_starts(&sha, 0) == 0 && mbedtls_sha256_update(&sha, cert + 32, PAYLOAD_SIZE) == 0 &&
+            mbedtls_sha256_finish(&sha, digest) == 0;
+  mbedtls_sha256_free(&sha);
+  mbedtls_pk_context key;
+  mbedtls_pk_init(&key);
+  ok = ok &&
+       mbedtls_pk_parse_public_key(&key, reinterpret_cast<const unsigned char*>(kMuseCoexistPublicKeyPem),
+                                   sizeof(kMuseCoexistPublicKeyPem)) == 0 &&
+       mbedtls_pk_verify(&key, MBEDTLS_MD_SHA256, digest, sizeof(digest), cert + 218, length) == 0;
+  mbedtls_pk_free(&key);
+  return ok;
+}
+
+bool layout(const esp_partition_t* part, const esp_partition_t* running) {
+  uint32_t flashSize = 0;
+  if (esp_flash_get_size(nullptr, &flashSize) != ESP_OK) return false;
+  const auto valid = [flashSize](const esp_partition_t* p) {
+    return p && p->type == ESP_PARTITION_TYPE_APP && p->subtype >= ESP_PARTITION_SUBTYPE_APP_OTA_MIN &&
+           p->subtype <= ESP_PARTITION_SUBTYPE_APP_OTA_MAX && p->address >= 0x10000 && p->address % 0x10000 == 0 &&
+           p->size && p->size % 4096 == 0 && p->address <= flashSize && p->size <= flashSize - p->address;
+  };
+  const esp_partition_t* nvs =
+      esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_NVS, nullptr);
+  if (!valid(part) || !valid(running) || !nvs || part->subtype == running->subtype ||
+      !(part->address + part->size <= running->address || running->address + running->size <= part->address))
+    return false;
+  if (nvs->address > flashSize || nvs->size > flashSize - nvs->address ||
+      !(nvs->address + nvs->size <= part->address || part->address + part->size <= nvs->address) ||
+      !(nvs->address + nvs->size <= running->address || running->address + running->size <= nvs->address))
+    return false;
+  LOG_INF("MUSE", "running=%s @0x%x size=0x%x peer=%s @0x%x size=0x%x NVS @0x%x size=0x%x", running->label,
+          static_cast<unsigned>(running->address), static_cast<unsigned>(running->size), part->label,
+          static_cast<unsigned>(part->address), static_cast<unsigned>(part->size), static_cast<unsigned>(nvs->address),
+          static_cast<unsigned>(nvs->size));
+  return true;
+}
+bool verify(const Source& source, const esp_partition_t* running, std::string& error) {
+  Geometry g{};
+  uint32_t offset = 0;
+  if (!geometry(source, g) || (source.file && g.size != source.size) || !intact(source, g) ||
+      !findCertificate(source, g, offset))
+    return reject(error, "image");
+  uint8_t cert[CERT_SIZE];
+  if (!read(source, offset, cert, sizeof(cert))) return reject(error, "read");
+  const uint8_t* p = cert + 32;
+  if (std::memcmp(p, "MPXCERT1", 8) || u32(p + 8) != 1 || u32(p + 12) != g.size || u32(p + 20) != offset ||
+      u32(p + 24) != g.checksum || u32(p + 28) != g.digest || u32(p + 32) != 9 || !fixed(p + 36, 32, "muse-gadget") ||
+      !padded(p + 68, 32) || !fixed(p + 100, 16, "xteink_x4_pro") || !signature(cert))
+    return reject(error, "certificate");
+  uint32_t tokenOffset = u32(p + 16);
+  if (!contained(g, tokenOffset, TOKEN_SIZE) ||
+      !(tokenOffset + TOKEN_SIZE <= offset || offset + CERT_SIZE <= tokenOffset))
+    return reject(error, "ranges");
+  const uint32_t descriptorEnd = g.start[0] + sizeof(esp_app_desc_t);
+  if ((tokenOffset < descriptorEnd && tokenOffset + TOKEN_SIZE > g.start[0]) ||
+      (offset < descriptorEnd && offset + CERT_SIZE > g.start[0]))
+    return reject(error, "descriptor_ranges");
+  uint8_t token[TOKEN_SIZE], digest[32];
+  if (!read(source, tokenOffset, token, sizeof(token)) || !canonicalToken(token)) return reject(error, "token");
+  esp_app_desc_t description{};
+  if (g.end[0] - g.start[0] < sizeof(description) || !read(source, g.start[0], &description, sizeof(description)) ||
+      description.magic_word != ESP_APP_DESC_MAGIC_WORD || std::memcmp(description.project_name, p + 36, 32) ||
+      std::memcmp(description.version, p + 68, 32))
+    return reject(error, "descriptor");
+  if (!hash(source, g, digest, tokenOffset, offset) || std::memcmp(digest, p + 116, 32))
+    return reject(error, "identity");
+  Source peerSource{running, nullptr, running->size};
+  Geometry peer{};
+  if (!geometry(peerSource, peer) || peer.size != u32(p + 180) || !intact(peerSource, peer) ||
+      !hash(peerSource, peer, digest) || std::memcmp(digest, p + 148, 32))
+    return reject(error, "peer");
+  return true;
+}
+}  // namespace
+#endif
+
+bool HalMuseCoexist::verifyPartition(const esp_partition_t* part, std::string& error) {
+  error.clear();
+#if CROSSMUX_MUSE_COEXIST
+  const esp_partition_t* running = esp_ota_get_running_partition();
+  if (!layout(part, running)) return reject(error, "layout");
+  Source source{part, nullptr, part->size};
+  if (!verify(source, running, error)) return false;
+  Geometry g{};
+  if (!geometry(source, g)) return reject(error, "image");
+  esp_partition_pos_t location = {part->address, part->size};
+  esp_image_metadata_t metadata{};
+  if (esp_image_verify(ESP_IMAGE_VERIFY, &location, &metadata) != ESP_OK || metadata.image_len != g.size)
+    return reject(error, "sdk_verify");
+  return true;
+#else
+  (void)part;
+  error = "disabled";
+  return false;
+#endif
+}
+
+bool HalMuseCoexist::verifyFile(const char* path, std::string& error) {
+  error.clear();
+#if CROSSMUX_MUSE_COEXIST
+  HalFile file;
+  if (!path || !Storage.openFileForRead("MUSE", path, file) || !file) return reject(error, "open");
+  return verifyOpenFile(file, error);
+#else
+  (void)path;
+  error = "disabled";
+  return false;
+#endif
+}
+
+bool HalMuseCoexist::verifyOpenFile(HalFile& file, std::string& error) {
+  error.clear();
+#if CROSSMUX_MUSE_COEXIST
+  const esp_partition_t* part = esp_ota_get_next_update_partition(nullptr);
+  const esp_partition_t* running = esp_ota_get_running_partition();
+  if (!layout(part, running)) return reject(error, "layout");
+  if (!file) return reject(error, "open");
+  Source source{nullptr, &file, file.fileSize()};
+  if (source.size > part->size) return reject(error, "size");
+  if (!verify(source, running, error)) return false;
+  if (!file.seekSet(0)) return reject(error, "seek");
+  return true;
+#else
+  (void)file;
+  error = "disabled";
+  return false;
+#endif
+}
+
+bool HalMuseCoexist::switchToMuse(std::string& error) {
+#if CROSSMUX_MUSE_COEXIST
+  const esp_partition_t* part = esp_ota_get_next_update_partition(nullptr);
+  if (!verifyPartition(part, error)) return false;
+  if (esp_ota_set_boot_partition(part) != ESP_OK) return reject(error, "boot_select");
+  esp_restart();
+  return true;
+#else
+  error = "disabled";
+  return false;
+#endif
+}
