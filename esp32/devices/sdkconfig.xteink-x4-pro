# Xteink X4 Pro: ESP32-S3, 16 MB flash, 8 MB octal PSRAM.
# Apply last after sdkconfig.defaults. App-only OTA; no eFuse changes.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_GADGET_PRODUCT_NAME="Muse Pocket"
CONFIG_HOMEHUB_LED_BACKEND_XTEINK_X4_PRO=y
CONFIG_HOMEHUB_BLE_NAME_SUFFIX="-Pocket"
CONFIG_HOMEHUB_SHOW_AGENT_NAME=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_HOMEHUB_OTA_ENABLED=n
CONFIG_MUSE_ENABLED=n
CONFIG_HOMEHUB_NVS_ENCRYPTION=n
CONFIG_HOMEHUB_PAIRING_EFUSE_AUTH=n
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM_MODE_QUAD=n
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.xteink-x4-pro.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_FLASH_ENC_ENABLED=n
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=n
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=n
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_GADGET_SDK_TOKEN=""
